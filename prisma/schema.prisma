// TestMetrix veri modeli.
//
// Kendine ait, izole bir Supabase Postgres projesinde yaşıyor — başka hiçbir
// uygulamayla paylaşılmıyor. Bu yüzden şema tanımında `public`'ten farklı bir
// schema'ya ya da özel bir adapter seçeneğine gerek yok.
//
// Kimlik doğrulama kendi içimizde: Auth.js v5, JWT session stratejisi.
// E-posta/şifre (bcrypt hash) ve Google OAuth destekleniyor. Ayrı bir
// oturum/hesap tablosu yok — JWT stratejisinde gerekmiyor; `app_user` hem
// kimlik hem de uygulama profilini tek satırda tutuyor.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7'de bağlantı URL'i şemada değil, prisma.config.ts'te tanımlanır.
datasource db {
  provider = "postgresql"
}

/// Rol yalnızca sunucu tarafında atanır. Eski Express backend'inde `role`
/// doğrudan register isteğinin gövdesinden okunuyordu; herkes kendini
/// "Yönetici" yapabiliyordu.
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AnswerOption {
  A
  B
  C
  D
  E
  BOS
}

/// Kullanıcı hesabı. E-posta/şifre ile ya da Google ile girilebilir; ikisi
/// aynı satırda buluşur (aynı e-posta = aynı hesap).
///
/// `passwordHash` nullable: yalnızca Google ile kaydolan kullanıcının şifresi
/// yok. `id` sabit yerel birincil anahtar; klasör/sınav foreign key hedefi.
model AppUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  image          String?
  /// bcrypt hash. Google-only kullanıcıda null — parola girişiyle giriş
  /// denenirse `null` kontrolü bunu engeller.
  passwordHash   String?
  university     String?
  phone          String?
  role           Role      @default(TEACHER)
  kvkkAcceptedAt DateTime?

  /// Kaba kuvvet koruması. GateHub'ın sağladığı hız sınırlama artık yok;
  /// bunun yerini alıyor. 5 yanlış denemeden sonra hesap geçici kilitlenir.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders             Folder[]
  exams                Exam[]
  passwordResetTokens PasswordResetToken[]

  @@map("app_user")
}

/// Şifre sıfırlama bağlantısı. Token'ın kendisi asla saklanmaz — yalnızca
/// SHA-256 hash'i; e-posta ele geçirilse bile veritabanı sızıntısı token'ı
/// yeniden üretmeye yetmez. Kullanılınca ya da süresi dolunca silinir.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Folder {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner AppUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exams Exam[]

  @@index([ownerId, sortOrder])
  @@map("folder")
}

model Exam {
  id            String   @id @default(cuid())
  folderId      String
  ownerId       String
  name          String
  questionCount Int
  studentCount  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner      AppUser     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  answerKeys AnswerKey[]
  students   Student[]
  answers    Answer[]
  stat       ExamStat?
  itemStats  ItemStat[]

  @@index([ownerId])
  @@index([folderId])
  @@map("exam")
}

model AnswerKey {
  examId        String
  questionNo    Int
  correctOption AnswerOption

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([examId, questionNo])
  @@map("answer_key")
}

model Student {
  id       String @id @default(cuid())
  examId   String
  fullName String
  rowNo    Int

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([examId, rowNo])
  @@map("student")
}

/// Sınavın ham cevap matrisi. Eski sürümde tüm Excel tek bir JSON alanına
/// (`file_data`) yazılıyordu; bu hem Mongo'nun 16MB belge limitine hem de
/// Vercel'in 4.5MB istek gövdesi limitine takılıyor, üstelik hiçbir sorgu
/// yazılmasına izin vermiyordu.
model Answer {
  examId     String
  studentId  String
  questionNo Int
  option     AnswerOption

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([examId, studentId, questionNo])
  @@index([examId, questionNo])
  @@map("answer")
}

/// Hesaplanmış test istatistikleri önbelleği. Kaynak doğruluk her zaman
/// `answer` + `answer_key`; buradaki değerler `analyzeExam` çıktısıdır.
/// Hesaplanamayan değerler NULL (eskiden NaN üretilip 0 olarak gösteriliyordu).
model ExamStat {
  examId               String   @id
  mean                 Float
  median               Float?
  minScore             Float?
  maxScore             Float?
  range                Float?
  variance             Float
  stdDeviation         Float
  skewness             Float?
  kurtosis             Float?
  coefficientVariation Float?
  successRate          Float?
  kr20                 Float?
  kr21                 Float?
  computedAt           DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_stat")
}

model ItemStat {
  examId           String
  questionNo       Int
  difficulty       Float
  correctCount     Int
  variance         Float
  stdDeviation     Float
  discrimination   Float
  rbis             Float?
  prbis            Float?
  reliabilityIndex Float?

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([examId, questionNo])
  @@map("item_stat")
}
