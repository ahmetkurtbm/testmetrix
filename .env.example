# cp .env.example .env.local

# PostgreSQL (Supabase): uygulama bağlantısı (pooler) ve migration bağlantısı
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js: AUTH_SECRET için `npx auth secret`; AUTH_URL sitenin kök adresi
AUTH_SECRET=""
AUTH_URL="http://localhost:3001"

# Google ile giriş (isteğe bağlı; boşsa yalnızca e-posta/şifre)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google ile doğrulanmış girişte ADMIN olacak e-postalar (virgülle)
ADMIN_EMAILS=""

# Şifre sıfırlama e-postası (boşsa bağlantı sunucu günlüğüne yazılır)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TestMetrix <onboarding@resend.dev>"
